# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your real keys.

# Alpaca API credentials
# Get yours at https://alpaca.markets
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# IMPORTANT: Start with paper trading to validate the strategy.
# Paper:  https://paper-api.alpaca.markets
# Live:   https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Comma-separated list of symbols to trade
SYMBOLS=AAPL,MSFT,NVDA

# Strategy parameters (defaults are sensible, tune after backtesting)
EMA_SHORT=9
EMA_LONG=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Risk management
RISK_PER_TRADE=0.01        # fraction of equity risked per trade (0.01 = 1%)
STOP_LOSS_PCT=0.02         # 2% stop loss
TAKE_PROFIT_PCT=0.04       # 4% take profit
MAX_DAILY_LOSS_PCT=0.05    # halt trading if daily loss exceeds 5% of equity

# Bar timeframe: 1Min, 5Min, 15Min, 1H, 1D
BAR_TIMEFRAME=5Min
LOOKBACK_BARS=50

# How often to poll for new signals (seconds)
POLL_INTERVAL=60
